# Copy this file to `.env` and fill in your Firebase web app config.
# NEVER commit a real `.env` — it is gitignored. These values are public
# client identifiers (not secrets), but keep real project config out of git.
#
# Get these from Firebase console > Project settings > Your apps > Web app.
# See SETUP.md for the exact steps.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud fallback model used by Firebase AI Logic when on-device inference is
# unavailable. Override only if you know the model id is valid for your
# Gemini API provider. Default: gemini-3.8-flash
VITE_CLOUD_MODEL=gemini-3.8-flash

# reCAPTCHA v3 site key for Firebase App Check in production (hosted) builds.
# Leave empty for localhost development: the App Check debug provider is used
# instead. See SETUP.md step 5.
VITE_RECAPTCHA_SITE_KEY=
